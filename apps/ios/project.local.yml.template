# Copy to project.local.yml (gitignored) and fill in your values, OR just run
# ./generate.sh — it writes project.local.yml for you from the repo-root .env.
#
# This file is merged into project.yml by xcodegen (via its `include`).
#
# NOTE: there is no API-key setting here any more. Nothing reads an Anthropic
# key out of Info.plist — a key baked into a build is extractable from the IPA.
# For a local real-core run, export ANTHROPIC_API_KEY in the environment the
# app launches from (Xcode scheme env vars, or
# `SIMCTL_CHILD_ANTHROPIC_API_KEY=... xcrun simctl launch ...`), or set
# JEFE_PROXY_URL + JEFE_APP_SECRET below to go through the proxy.
settings:
  base:
    # Provider base URL (e.g. https://api.ppq.ai for PPQ). Empty => provider
    # default (api.anthropic.com). ./generate.sh populates this from
    # ANTHROPIC_BASE_URL in the repo-root .env.
    ANTHROPIC_BASE_URL: ""
